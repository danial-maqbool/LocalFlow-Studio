{
  "steps": [
    {"id": "scan", "type": "scan", "config": {}},
    {"id": "txt", "type": "filter", "config": {"pattern": "*.txt"}},
    {"id": "read", "type": "read", "config": {}},
    {"id": "invoice", "type": "extract", "config": {"field": "invoice_id", "pattern": "Invoice ID:\\s*([A-Z0-9-]+)"}},
    {"id": "name", "type": "rename", "config": {"template": "${invoice_id}.txt"}},
    {"id": "copies", "type": "copy", "config": {}},
    {"id": "register", "type": "csv", "config": {"name": "register.csv", "fields": ["invoice_id", "name", "output_name"]}}
  ]
}
